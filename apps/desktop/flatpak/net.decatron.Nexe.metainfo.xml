<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.decatron.Nexe</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>Nexe</name>
  <summary>Chat and voice for streamers</summary>
  <developer id="net.decatron">
    <name>Decatron</name>
  </developer>
  <description>
    <p>Nexe is a real-time communication platform built for streamers and gaming communities. Everything that usually needs an external bot is built in.</p>
    <ul>
      <li>Servers with channels, roles and permissions</li>
      <li>Text chat with threads, reactions and search</li>
      <li>Voice, video and screen sharing</li>
      <li>Direct messages and friends</li>
      <li>Native Twitch integration: live status, roles and clips</li>
      <li>Steam-style customizable profiles</li>
    </ul>
  </description>
  <launchable type="desktop-id">net.decatron.Nexe.desktop</launchable>
  <url type="homepage">https://nexe.decatron.net</url>
  <url type="bugtracker">https://github.com/decatrondev/nexe/issues</url>
  <url type="vcs-browser">https://github.com/decatrondev/nexe</url>
  <branding>
    <color type="primary" scheme_preference="light">#e0e7ff</color>
    <color type="primary" scheme_preference="dark">#0f172a</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://nexe.decatron.net/screenshots/app-full.png</image>
      <caption>Servers, channels and chat</caption>
    </screenshot>
    <screenshot>
      <image>https://nexe.decatron.net/screenshots/chat.png</image>
      <caption>Real-time chat</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <provides>
    <binary>nexe</binary>
  </provides>
  <categories>
    <category>Network</category>
    <category>Chat</category>
  </categories>

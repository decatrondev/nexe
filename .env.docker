# Nexe Docker Compose Environment
# Copy to .env and customize before running: docker compose up -d

# ---- Core ----
NEXE_ENV=development
POSTGRES_PASSWORD=nexe_dev_pass
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ---- URLs (external access) ----
BASE_URL=http://localhost:8090
FRONTEND_URL=http://localhost:1420

# ---- Twitch Integration (optional) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
TWITCH_EVENTSUB_SECRET=

# ---- Cloudflare R2 Storage (optional, falls back to local) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- LiveKit (optional, for voice/video) ----
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ---- Web Push (optional) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:nexe@localhost

# ---- Email (optional) ----
RESEND_API_KEY=

# ---- Port overrides ----
# GATEWAY_PORT=8090
# POSTGRES_PORT=5432
# REDIS_PORT=6379
